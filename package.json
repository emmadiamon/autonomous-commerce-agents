{
  "name": "autonomous-commerce-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/evaluate.ts",
    "eval:json": "tsx scripts/evaluate.ts --json",
    "eval:live": "tsx scripts/evaluate-live.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "pg": "^8.16.0",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
